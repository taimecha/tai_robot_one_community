<!--
  Validate the padded body/forks and launch rotation before following a route.
  Keep a usable path stable; compare Direct, XY, arcs and stationary turns.
  Rank by length first; smoothness breaks numerical length ties only.
  Recovery never backs up because a distant destination is blocked.
  Rank complete routes via checked forward starts before local escape.
  Advance only along a full checked route or to a checked turning/exit pocket.
  BackUp stays active continuously until an exit is available at the current pose.
  Do not clear obstacle data and do not blindly spin into an obstacle.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>
    <ResetEscapeState reset_motion_history="true"/>
    <WaitForClearanceData/>
    <RecoveryNode number_of_retries="2" name="ReconsiderFreshRoutesBeforeAbort">
    <RecoveryNode number_of_retries="2147483647" name="NavigateUntilEscapeBlocked">
      <SubTree ID="RankedCurrentRoutes" select_route_only="false" refresh_blocked_route="true" max_route_length="2.5" _autoremap="true"/>
      <ReactiveFallback name="EscapeBeforeGivingUp">
        <GoalUpdated/>
        <Sequence name="TryForwardThenRetreat">
          <PathFootprintClear data_only="true"/>
          <ResetEscapeState/>
          <Fallback name="ForwardAlternativesBeforeReverse">
            <SubTree ID="RankedCurrentRoutes" select_route_only="false" refresh_blocked_route="true" max_route_length="2.5" _autoremap="true"/>
            <Sequence name="ForwardRoutesBeforeRestrictedLocalEscape">
              <PathFootprintClear motion="motion_fault_free" goal="{goal}" controller_error="{follow_path_error_code}"/>
              <Fallback name="CompleteForwardRoutesBeforeLastResortManeuvers">
                <Sequence>
                  <PathFootprintClear motion="route_control_available" goal="{goal}"/>
                <ForwardRouteSearch goal="{goal}" refresh_on_failure="true" compare_planners="true" max_near_goal_length="2.5" candidate_planner_request="{forward_planner_request}" candidate_distance="{forward_route_distance}" candidate_path="{forward_candidate_path}" candidate_planner="{forward_candidate_planner}" controller_error="{follow_path_error_code}" path="{path}" planner_id="{path_planner}" local_check_distance="{forward_route_local_range}">
                  <ReactiveSequence name="SearchForwardStartsWithoutMotion">
                    <PathFootprintClear data_only="true"/>
                    <Sequence>
                      <PathFootprintClear motion="forward_candidate" goal="{goal}" candidate_distance="{forward_route_distance}" forward_start="{forward_route_start}"/>
                      <Fallback>
                        <PathFootprintClear motion="forward_direct" candidate_start="{forward_route_start}" goal="{goal}" checked_path="{forward_candidate_path}" path_planner="{forward_candidate_planner}" blocked_near_robot="{forward_candidate_blocked}"/>
                      <Sequence>
                        <ComputePathToPose goal="{goal}" start="{forward_route_start}" use_start="true" path="{forward_candidate_path}" planner_id="{forward_planner_request}" error_code_id="{forward_route_planner_error}"/>
                        <PathFootprintClear motion="forward_route" path="{forward_candidate_path}" candidate_start="{forward_route_start}" goal="{goal}" planner_id="{forward_planner_request}" checked_path="{forward_candidate_path}" path_planner="{forward_candidate_planner}" blocked_near_robot="{forward_candidate_blocked}"/>
                      </Sequence>
                      </Fallback>
                    </Sequence>
                  </ReactiveSequence>
                  <PathFootprintClear path="{path}" goal="{goal}" planner_id="{path_planner}" prepared="true" local_check_distance="{forward_route_local_range}" checked_path="{path}" path_planner="{path_planner}" blocked_near_robot="{local_escape_required}"/>
                  <ReactiveSequence name="ExecuteRankedForwardRouteWithFreshCollisionChecks">
                    <PathFootprintClear motion="route_control_available" goal="{goal}"/>
                    <PathFootprintClear path="{path}" goal="{goal}" planner_id="{path_planner}" prepared="true" local_check_distance="{forward_route_local_range}" checked_path="{path}" path_planner="{path_planner}" blocked_near_robot="{local_escape_required}"/>
                    <FollowPath path="{path}" controller_id="FollowPath" error_code_id="{follow_path_error_code}"/>
                  </ReactiveSequence>
                </ForwardRouteSearch>
                </Sequence>
                <Sequence name="LocalManeuversOnlyAfterHealthyRouteFailures">
                  <PathFootprintClear motion="recovery_allowed" goal="{goal}" planner_error="{compute_path_error_code}" controller_error="{follow_path_error_code}" local_blocked="{local_escape_required}"/>
              <IfThenElse name="AdvanceBeforeOtherEscape">
                  <PathFootprintClear motion="forward" goal="{goal}" forward_distance="{escape_forward_distance}"/>
                  <Fallback name="AdvanceOrRetreatWhenPocketIsLost">
                    <Sequence>
                      <PathFootprintClear motion="forward_begin" goal="{goal}" candidate_distance="{escape_forward_distance}"/>
                      <ReactiveSequence>
                        <PathFootprintClear motion="forward_safe" goal="{goal}"/>
                        <DriveOnHeading dist_to_travel="{escape_forward_distance}" speed="0.08" time_allowance="25.0" error_code_id="{escape_forward_error}"/>
                      </ReactiveSequence>
                      <PathFootprintClear motion="forward_complete" goal="{goal}"/>
                      <ResetEscapeState invalidate_path="true"/>
                    </Sequence>
                    <Sequence>
                      <PathFootprintClear motion="forward_collision" goal="{goal}" motion_error="{escape_forward_error}"/>
                      <Wait wait_duration="0.3"/>
                      <PathFootprintClear data_only="true"/>
                      <SubTree ID="CheckedRetreatAndTurn" _autoremap="true"/>
                    </Sequence>
                  </Fallback>
                <IfThenElse name="TurnBeforeRetreat">
                  <PathFootprintClear motion="turn" goal="{goal}" turn_angle="{escape_turn_angle}"/>
                  <Fallback name="TurnOrRetreatAfterGeometricStop">
                    <Sequence>
                      <PathFootprintClear motion="turn_begin" goal="{goal}" candidate_angle="{escape_turn_angle}"/>
                      <Spin spin_dist="{escape_turn_angle}" time_allowance="25.0" error_code_id="{escape_turn_error}"/>
                      <ResetEscapeState invalidate_path="true" turn_completed="true"/>
                    </Sequence>
                    <Sequence name="ContinueRetreatAfterSpinCollision">
                      <PathFootprintClear motion="turn_collision" goal="{goal}" motion_error="{escape_turn_error}"/>
                      <SubTree ID="CheckedRetreatAndTurn" _autoremap="true"/>
                    </Sequence>
                    <Sequence name="RetreatIfSelectedTurnNoLongerFits">
                      <PathFootprintClear motion="lost_exit" goal="{goal}" motion_error="{escape_turn_error}"/>
                      <SubTree ID="CheckedRetreatAndTurn" _autoremap="true"/>
                    </Sequence>
                  </Fallback>
                <SubTree ID="CheckedRetreatAndTurn" _autoremap="true"/>
                </IfThenElse>
              </IfThenElse>
                </Sequence>
                <SubTree ID="RankedCurrentRoutes" select_route_only="false" refresh_blocked_route="true" max_route_length="0.0" _autoremap="true"/>
              </Fallback>
            </Sequence>
          </Fallback>
        </Sequence>
      </ReactiveFallback>
    </RecoveryNode>
      <Sequence name="WaitForFreshObservationsAndReplan">
        <PathFootprintClear data_only="true"/>
        <PathFootprintClear motion="motion_fault_free" goal="{goal}" controller_error="{follow_path_error_code}"/>
        <Wait wait_duration="1.5"/>
        <ResetEscapeState invalidate_path="true"/>
        <PathFootprintClear data_only="true"/>
      </Sequence>
    </RecoveryNode>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="RankedCurrentRoutes">
    <Fallback>
    <Sequence name="NearGoalCheckedSpin">
      <PathFootprintClear motion="terminal_turn" goal="{goal}" turn_angle="{terminal_turn_angle}"/>
      <Fallback>
        <Sequence>
          <Spin spin_dist="{terminal_turn_angle}" time_allowance="25.0" error_code_id="{terminal_turn_error}"/>
          <PathFootprintClear motion="goal_pose_reached" goal="{goal}"/>
        </Sequence>
        <Sequence>
          <PathFootprintClear motion="turn_collision" goal="{goal}" motion_error="{terminal_turn_error}"/>
          <AlwaysFailure/>
        </Sequence>
      </Fallback>
    </Sequence>
    <PathFootprintClear motion="goal_completed" goal="{goal}"/>
    <Sequence>
    <PathFootprintClear motion="route_control_available" goal="{goal}"/>
    <RankedRouteSearch explore_forward_detours="true" explore_goal_approaches="true" max_near_goal_length="{max_route_length}" candidate_departure_mode="{route_departure_mode}" candidate_distance="{route_departure_distance}" refresh_on_failure="{refresh_blocked_route}" goal="{goal}" forward_search="false" selection_only="{select_route_only}" search_timeout="20.0" candidate_planner_request="{route_planner_request}" candidate_path="{route_candidate_path}" candidate_planner="{route_candidate_planner}" controller_error="{follow_path_error_code}" path="{path}" planner_id="{path_planner}" local_check_distance="{route_local_range}">
      <Sequence name="CompareRoutesWithoutMotion">
        <PathFootprintClear data_only="true"/>
        <Switch3 variable="{route_departure_mode}" case_1="current" case_2="forward" case_3="approach">
          <Switch6 variable="{route_planner_request}" case_1="Direct" case_2="DirectArc" case_3="GridShortest" case_4="GridBased" case_5="SE2Arc" case_6="SE2Fallback">
            <PathFootprintClear motion="direct" goal="{goal}" checked_path="{route_candidate_path}" path_planner="{route_candidate_planner}" blocked_near_robot="{local_escape_required}"/>
            <PathFootprintClear motion="direct_arc" goal="{goal}" checked_path="{route_candidate_path}" path_planner="{route_candidate_planner}" blocked_near_robot="{local_escape_required}"/>
            <Sequence>
              <ComputePathToPose goal="{goal}" path="{route_candidate_path}" planner_id="GridShortest" error_code_id="{compute_path_error_code}"/>
              <PathFootprintClear path="{route_candidate_path}" goal="{goal}" planner_id="GridShortest" checked_path="{route_candidate_path}" path_planner="{route_candidate_planner}" blocked_near_robot="{local_escape_required}"/>
            </Sequence>
            <Sequence>
              <ComputePathToPose goal="{goal}" path="{route_candidate_path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
              <PathFootprintClear path="{route_candidate_path}" goal="{goal}" planner_id="GridBased" checked_path="{route_candidate_path}" path_planner="{route_candidate_planner}" blocked_near_robot="{local_escape_required}"/>
            </Sequence>
            <Sequence>
              <ComputePathToPose goal="{goal}" path="{route_candidate_path}" planner_id="SE2Arc" error_code_id="{compute_path_error_code}"/>
              <PathFootprintClear path="{route_candidate_path}" goal="{goal}" planner_id="SE2Arc" checked_path="{route_candidate_path}" path_planner="{route_candidate_planner}" blocked_near_robot="{local_escape_required}"/>
            </Sequence>
            <Sequence>
              <ComputePathToPose goal="{goal}" path="{route_candidate_path}" planner_id="SE2Fallback" error_code_id="{compute_path_error_code}"/>
              <PathFootprintClear path="{route_candidate_path}" goal="{goal}" planner_id="SE2Fallback" checked_path="{route_candidate_path}" path_planner="{route_candidate_planner}" blocked_near_robot="{local_escape_required}"/>
            </Sequence>
            <AlwaysFailure/>
          </Switch6>
          <Sequence name="CompareForwardDepartureBeforeAcceptingDetour">
            <PathFootprintClear motion="forward_candidate" goal="{goal}" candidate_distance="{route_departure_distance}" forward_start="{route_departure_start}"/>
            <Fallback>
              <PathFootprintClear motion="forward_direct" candidate_start="{route_departure_start}" goal="{goal}" checked_path="{route_candidate_path}" path_planner="{route_candidate_planner}" blocked_near_robot="{local_escape_required}"/>
            <Sequence>
            <ComputePathToPose goal="{goal}" start="{route_departure_start}" use_start="true" path="{route_candidate_path}" planner_id="{route_planner_request}" error_code_id="{compute_path_error_code}"/>
            <PathFootprintClear motion="forward_route" path="{route_candidate_path}" candidate_start="{route_departure_start}" goal="{goal}" planner_id="{route_planner_request}" checked_path="{route_candidate_path}" path_planner="{route_candidate_planner}" blocked_near_robot="{local_escape_required}"/>
            </Sequence>
            </Fallback>
          </Sequence>
          <Sequence name="AlignBeforeEnteringConstrainedGoal">
            <PathFootprintClear motion="goal_approach_candidate" goal="{goal}" candidate_distance="{route_departure_distance}" approach_goal="{route_approach_goal}"/>
            <ComputePathToPose goal="{route_approach_goal}" path="{route_candidate_path}" planner_id="{route_planner_request}" error_code_id="{compute_path_error_code}"/>
            <PathFootprintClear motion="approach_route" path="{route_candidate_path}" candidate_start="{route_approach_goal}" goal="{goal}" planner_id="{route_planner_request}" checked_path="{route_candidate_path}" path_planner="{route_candidate_planner}" blocked_near_robot="{local_escape_required}"/>
          </Sequence>
          <AlwaysFailure/>
        </Switch3>
      </Sequence>
      <PathFootprintClear path="{path}" goal="{goal}" planner_id="{path_planner}" prepared="true" local_check_distance="{route_local_range}" checked_path="{path}" path_planner="{path_planner}" blocked_near_robot="{local_escape_required}"/>
      <ReactiveSequence name="TryShortestThenLongerIfBlocked">
        <PathFootprintClear motion="route_control_available" goal="{goal}"/>
        <PathFootprintClear path="{path}" goal="{goal}" planner_id="{path_planner}" prepared="true" local_check_distance="{route_local_range}" checked_path="{path}" path_planner="{path_planner}" blocked_near_robot="{local_escape_required}"/>
        <FollowPath path="{path}" controller_id="FollowPath" error_code_id="{follow_path_error_code}"/>
      </ReactiveSequence>
    </RankedRouteSearch>
    </Sequence>
    </Fallback>
  </BehaviorTree>
  <BehaviorTree ID="CheckedRetreatAndTurn">
    <Fallback name="ContinuousRetreatUntilSafeTurnOrRearBlocked">
      <ReactiveSequence>
        <PathFootprintClear motion="reverse_needed" goal="{goal}"/>
        <BackUp backup_dist="10.0" backup_speed="0.08" time_allowance="180.0" error_code_id="{backup_error_code}"/>
      </ReactiveSequence>
      <Sequence name="BrakeThenExecuteAvailableTurnNow">
        <PathFootprintClear motion="escape_available" goal="{goal}"/>
        <Wait wait_duration="0.3"/>
        <PathFootprintClear data_only="true"/>
        <IfThenElse>
          <PathFootprintClear motion="turn" goal="{goal}" turn_angle="{escape_turn_angle}"/>
          <Fallback>
            <Sequence>
              <PathFootprintClear motion="turn_begin" goal="{goal}" candidate_angle="{escape_turn_angle}"/>
              <Spin spin_dist="{escape_turn_angle}" time_allowance="25.0" error_code_id="{escape_turn_error}"/>
              <ResetEscapeState turn_completed="true"/>
            </Sequence>
            <PathFootprintClear motion="turn_collision" goal="{goal}" motion_error="{escape_turn_error}"/>
          </Fallback>
          <PathFootprintClear motion="escape_available" goal="{goal}"/>
        </IfThenElse>
        <ResetEscapeState invalidate_path="true"/>
      </Sequence>
      <Sequence name="ContinueRetreatIfTurningPocketLostWhileBraking">
        <PathFootprintClear motion="lost_exit" goal="{goal}" motion_error="{escape_turn_error}"/>
        <ResetEscapeState invalidate_path="true"/>
        <Wait wait_duration="0.3"/>
        <PathFootprintClear data_only="true"/>
      </Sequence>
      <Sequence name="ReplanAfterRetreatStops">
        <PathFootprintClear motion="replan_after_retreat" goal="{goal}" motion_error="{backup_error_code}"/>
        <ResetEscapeState invalidate_path="true"/>
        <Wait wait_duration="0.3"/>
        <PathFootprintClear data_only="true"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>
