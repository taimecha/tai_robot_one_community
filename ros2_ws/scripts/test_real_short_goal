#!/usr/bin/env python3
"""Explicit, bounded real-robot Nav2 test. Run only with operator authorization.

Sends one short forward or reverse goal with unchanged heading through normal Nav2.
Cancels on stale LiDAR/odometry, unexpected travel direction/rotation, excess travel or
timeout. Never bypasses the smoother, Collision Monitor or base watchdog.
"""
import argparse
import json
import math
import time
import uuid

import rclpy
from geometry_msgs.msg import Twist
from action_msgs.srv import CancelGoal
from nav_msgs.msg import Odometry
from nav2_msgs.action import NavigateToPose
from rclpy.action import ActionClient
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import LaserScan
from tf2_ros import Buffer, TransformListener
from unique_identifier_msgs.msg import UUID


def heading(q):
    return math.atan2(2 * (q.w * q.z + q.x * q.y),
                      1 - 2 * (q.y * q.y + q.z * q.z))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--distance', type=float, default=0.45)
    parser.add_argument('--timeout', type=float, default=35.0)
    parser.add_argument('--heading', type=float, help='Explicit goal/travel yaw in map radians')
    args = parser.parse_args()
    if not -0.60 <= args.distance <= 0.60 or not 5 <= args.timeout <= 60:
        parser.error('Distance must be -0.60..0.60 m; timeout 5..60 s')
    if args.heading is not None and not math.isfinite(args.heading):
        parser.error('Heading must be finite')
    rclpy.init()
    node = rclpy.create_node('authorized_short_real_nav_test')
    buffer = Buffer()
    listener = TransformListener(buffer, node)
    state = {}

    def observed(key, message):
        state[key] = message
        state[key + '_received'] = time.monotonic()

    subscriptions = [
        node.create_subscription(Odometry, '/odom',
                                 lambda msg: observed('odom', msg), qos_profile_sensor_data),
        node.create_subscription(LaserScan, '/scan_filtered',
                                 lambda msg: observed('scan', msg), qos_profile_sensor_data),
        node.create_subscription(Twist, '/cmd_vel_safe',
                                 lambda msg: observed('command', msg), 10),
    ]
    stop_pub = node.create_publisher(Twist, '/cmd_vel_nav', 10)
    client = ActionClient(node, NavigateToPose, '/navigate_to_pose')
    handle = None
    result = None
    sent = False
    goal_id = UUID(uuid=list(uuid.uuid4().bytes))
    try:
        if not client.wait_for_server(timeout_sec=8):
            raise RuntimeError('Nav2 unavailable')
        end = time.monotonic() + 8
        pose = None
        while time.monotonic() < end:
            rclpy.spin_once(node, timeout_sec=0.05)
            try:
                pose = buffer.lookup_transform('map', 'base_footprint', rclpy.time.Time())
                if 'scan' in state and 'odom' in state:
                    break
            except Exception:
                pass
        if pose is None or 'scan' not in state or 'odom' not in state:
            raise RuntimeError('Missing TF/LiDAR/odometry; no goal sent')
        for key in ('scan', 'odom'):
            age = (node.get_clock().now() - rclpy.time.Time.from_msg(state[key].header.stamp)).nanoseconds / 1e9
            if not -0.1 <= age <= 0.5:
                raise RuntimeError('Stale sensor stamp; no goal sent')
        odom = state['odom']
        if abs(odom.twist.twist.linear.x) > 0.02 or abs(odom.twist.twist.angular.z) > 0.03:
            raise RuntimeError('Robot is already moving; no goal sent')
        x = pose.transform.translation.x
        y = pose.transform.translation.y
        yaw = heading(pose.transform.rotation)
        goal_yaw = yaw if args.heading is None else args.heading
        ox, oy = odom.pose.pose.position.x, odom.pose.pose.position.y
        odom_yaw = heading(odom.pose.pose.orientation)
        goal = NavigateToPose.Goal()
        goal.pose.header.frame_id = 'map'
        goal.pose.header.stamp = node.get_clock().now().to_msg()
        goal.pose.pose.position.x = x + args.distance * math.cos(goal_yaw)
        goal.pose.pose.position.y = y + args.distance * math.sin(goal_yaw)
        goal.pose.pose.orientation.z = math.sin(goal_yaw / 2)
        goal.pose.pose.orientation.w = math.cos(goal_yaw / 2)
        feedback = {}

        def update(msg):
            feedback['recoveries'] = msg.feedback.number_of_recoveries
            feedback['remaining'] = msg.feedback.distance_remaining

        print(json.dumps({'event': 'send_goal', 'start': [x, y, yaw],
                          'goal': [goal.pose.pose.position.x,
                                   goal.pose.pose.position.y, goal_yaw]}), flush=True)
        pending = client.send_goal_async(goal, feedback_callback=update, goal_uuid=goal_id)
        sent = True
        rclpy.spin_until_future_complete(node, pending, timeout_sec=5)
        if not pending.done():
            raise RuntimeError('Goal response timed out; acceptance unknown')
        handle = pending.result()
        if not handle.accepted:
            raise RuntimeError('Goal rejected')
        result = handle.get_result_async()
        started = time.monotonic()
        report = started
        reason = None
        while not result.done():
            rclpy.spin_once(node, timeout_sec=0.03)
            now = time.monotonic()
            odom = state['odom']
            travel = math.hypot(odom.pose.pose.position.x - ox, odom.pose.pose.position.y - oy)
            delta = heading(odom.pose.pose.orientation) - odom_yaw
            delta = math.atan2(math.sin(delta), math.cos(delta))
            if now - state['scan_received'] > 0.6 or now - state['odom_received'] > 0.5:
                reason = 'stale_sensor'
            elif travel > abs(args.distance) + 0.20:
                reason = 'excess_travel'
            elif abs(delta) > math.radians(35):
                reason = 'unexpected_rotation'
            elif 'command' in state and args.distance * state['command'].linear.x < -0.00015:
                reason = 'unexpected_travel_direction'
            elif now - started > args.timeout:
                reason = 'timeout'
            if reason:
                print(json.dumps({'event': 'cancel', 'reason': reason}), flush=True)
                break
            if now >= report:
                print(json.dumps({'event': 'progress', 'seconds': round(now - started, 2),
                                  'odom_travel': round(travel, 3), **feedback}), flush=True)
                report = now + 2
        if reason:
            pending_cancel = handle.cancel_goal_async()
            rclpy.spin_until_future_complete(node, pending_cancel, timeout_sec=3)
            rclpy.spin_until_future_complete(node, result, timeout_sec=3)
        record = {'event': 'result', 'reason': reason, **feedback}
        if result.done():
            record.update(status=result.result().status,
                          error_code=result.result().result.error_code,
                          error_msg=result.result().result.error_msg)
        else:
            record['status'] = 'CANCEL_NOT_CONFIRMED'
        pose = buffer.lookup_transform('map', 'base_footprint', rclpy.time.Time())
        record['final_pose'] = [pose.transform.translation.x, pose.transform.translation.y,
                                heading(pose.transform.rotation)]
        record['xy_error'] = math.hypot(
            pose.transform.translation.x - goal.pose.pose.position.x,
            pose.transform.translation.y - goal.pose.pose.position.y)
        print(json.dumps(record), flush=True)
        if record.get('status') != 4:
            raise RuntimeError('Short real goal did not succeed')
    finally:
        if handle is not None and handle.accepted and (result is None or not result.done()):
            pending = handle.cancel_goal_async()
            rclpy.spin_until_future_complete(node, pending, timeout_sec=3)
        elif sent and handle is None:
            # If acceptance is unknown, cancel this exact UUID, not all goals.
            cancel_client = node.create_client(CancelGoal, '/navigate_to_pose/_action/cancel_goal')
            if cancel_client.wait_for_service(timeout_sec=2):
                request = CancelGoal.Request()
                request.goal_info.goal_id = goal_id
                pending = cancel_client.call_async(request)
                rclpy.spin_until_future_complete(node, pending, timeout_sec=3)
        # Zero enters the same safety chain; never command the base directly.
        stop_until = time.monotonic() + 1
        while time.monotonic() < stop_until:
            stop_pub.publish(Twist())
            rclpy.spin_once(node, timeout_sec=0.05)
        client.destroy()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
