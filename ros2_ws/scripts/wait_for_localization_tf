#!/usr/bin/env python3

"""Delay navigation activation until AMCL supplies a usable map transform."""

import time

import rclpy
from rclpy.node import Node
from rclpy.time import Time
from tf2_ros import Buffer, TransformException, TransformListener


def main(args=None):
    rclpy.init(args=args)
    node = Node('wait_for_localization_tf')
    buffer = Buffer()
    listener = TransformListener(buffer, node)
    last_notice = 0.0
    try:
        while rclpy.ok():
            rclpy.spin_once(node, timeout_sec=0.2)
            if buffer.can_transform('map', 'base_footprint', Time()):
                try:
                    transform = buffer.lookup_transform(
                        'map', 'base_footprint', Time())
                    age = (node.get_clock().now() -
                           Time.from_msg(transform.header.stamp)).nanoseconds
                    if -0.5e9 <= age <= 1.5e9:
                        node.get_logger().info(
                            'AMCL map transform is fresh; starting Nav2 navigation')
                        return 0
                except TransformException:
                    pass
            now = time.monotonic()
            if now - last_notice >= 10.0:
                node.get_logger().warning(
                    'Waiting for AMCL map transform. If no saved pose exists, '
                    'set 2D Pose Estimate in RViz.')
                last_notice = now
        return 1
    finally:
        del listener
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    raise SystemExit(main())
